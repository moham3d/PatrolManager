
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-semibold text-gray-800">Incidents</h1>
        <div class="flex gap-2">
            <div class="bg-slate-200 rounded-lg p-1 flex">
                <button onclick="setView('grid')" id="grid-view-btn" class="px-3 py-1 rounded-md text-sm font-bold transition bg-white shadow-sm flex items-center">
                    <i data-lucide="layout-grid" class="w-4 h-4 mr-1"></i> Grid
                </button>
                <button onclick="setView('kanban')" id="kanban-view-btn" class="px-3 py-1 rounded-md text-sm font-bold transition text-slate-600 hover:text-slate-800 flex items-center">
                    <i data-lucide="columns" class="w-4 h-4 mr-1"></i> Kanban
                </button>
            </div>
            <a href="/incidents/create" class="bg-rose-600 text-white px-4 py-2 rounded hover:bg-rose-500 shadow flex items-center">
                <i data-lucide="alert-circle" class="w-5 h-5 mr-2"></i> Report Incident
            </a>
        </div>
    </div>

    <!-- Filters & Search -->
    <div class="mb-6 bg-white p-4 rounded-lg shadow flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="w-full md:w-1/3">
            <div class="relative">
                <label for="searchInput" class="sr-only">Search incidents</label>
                <i data-lucide="search" class="absolute left-3 top-3 text-slate-400 w-5 h-5"></i>
                <input type="text" id="searchInput" placeholder="Search incidents..."
                    class="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
        </div>
        <div class="flex gap-2 w-full md:w-auto overflow-x-auto">
            <label for="statusFilter" class="sr-only">Filter by status</label>
            <select id="statusFilter" class="border rounded-lg px-3 py-2 text-slate-700 bg-white focus:outline-none">
                <option value="all">All Status</option>
                <option value="new">New</option>
                <option value="investigating">Investigating</option>
                <option value="resolved">Resolved</option>
            </select>
            <label for="priorityFilter" class="sr-only">Filter by priority</label>
            <select id="priorityFilter" class="border rounded-lg px-3 py-2 text-slate-700 bg-white focus:outline-none">
                <option value="all">All Priorities</option>
                <option value="critical">Critical</option>
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low">Low</option>
            </select>
        </div>
    </div>

    <!-- Incident Cards Grid -->
    <div id="grid-view" class="block">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="incidentGrid">
            <% incidents.forEach(function(incident) { %>
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300 incident-card"
                    data-status="<%= incident.status %>" data-priority="<%= incident.priority %>"
                    data-search="<%= incident.type.toLowerCase() %> <%= incident.description ? incident.description.toLowerCase() : '' %> <%= incident.Site ? incident.Site.name.toLowerCase() : '' %>">

                    <!-- Card Header -->
                    <div class="p-5 border-b border-slate-100 flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <% let pColor='slate' ; if(incident.priority==='high' ) pColor='orange' ;
                                    if(incident.priority==='critical' ) pColor='rose' ; if(incident.priority==='medium' )
                                    pColor='amber' ; if(incident.priority==='low' ) pColor='emerald' ; %>
                                    <span
                                        class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-<%= pColor %>-100 text-<%= pColor %>-800">
                                        <%= incident.priority %>
                                    </span>
                                    <span class="text-[10px] text-slate-400">
                                        <%= new Date(incident.createdAt).toLocaleDateString() %>
                                    </span>
                            </div>
                            <h3 class="font-bold text-slate-800 text-lg hover:text-blue-600 transition">
                                <a href="/incidents/<%= incident.id %>">
                                    <%= incident.type %>
                                </a>
                            </h3>
                        </div>
                        <% let sColor='blue' ; if(incident.status==='new' ) sColor='purple' ;
                            if(incident.status==='resolved' ) sColor='emerald' ; %>
                            <span
                                class="px-3 py-1 rounded-full text-[10px] font-bold bg-<%= sColor %>-100 text-<%= sColor %>-800 uppercase">
                                <%= incident.status %>
                            </span>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 space-y-3">
                        <p class="text-slate-600 text-sm line-clamp-2">
                            <%= incident.description || 'No description provided.' %>
                        </p>

                        <div class="flex items-center text-sm text-slate-500">
                            <i data-lucide="map-pin" class="w-4 h-4 mr-2"></i>
                            <%= incident.Site ? incident.Site.name : 'Unknown Site' %>
                        </div>

                        <div class="flex items-center text-sm text-slate-500">
                            <i data-lucide="user" class="w-4 h-4 mr-2"></i>
                            <% if (incident.assignee) { %>
                                <span class="font-semibold text-slate-700">
                                    <%= incident.assignee.name %>
                                </span>
                                <% } else { %>
                                    <span class="italic text-slate-400">Unassigned</span>
                                    <% } %>
                        </div>
                    </div>

                    <!-- Card Footer (Actions) -->
                    <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2">
                        <!-- Manager Assign Action -->
                        <% if (['admin', 'manager', 'supervisor' ].includes(user.Role.name.toLowerCase())) { %>
                            <button onclick="openAssignModal('<%= incident.id %>', '<%= incident.type %>')"
                                class="text-slate-600 hover:text-blue-600 font-bold text-sm px-3 py-1 flex items-center">
                                <i data-lucide="<%= incident.assignee ? 'user-cog' : 'user-plus' %>" class="w-4 h-4 mr-1"></i>
                                <%= incident.assignee ? 'Re-assign' : 'Assign' %>
                            </button>
                            <% } %>

                                <!-- Guard Claim Action -->
                                <% if (!incident.assignee && ['guard'].includes(user.Role.name.toLowerCase())) { %>
                                    <form action="/incidents/<%= incident.id %>/claim" method="POST" class="inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit"
                                            class="bg-blue-600 text-white hover:bg-blue-700 font-bold text-sm px-4 py-2 rounded shadow transition">
                                            Claim
                                        </button>
                                    </form>
                                    <% } %>

                                        <!-- Resolve Action -->
                                        <% if (incident.status !=='resolved' ) { %>
                                            <% if (incident.assignedTo===user.id || ['manager', 'admin'
                                                ].includes(user.Role.name.toLowerCase())) { %>
                                                <button onclick="openResolveModal('<%= incident.id %>')"
                                                    class="bg-emerald-600 text-white hover:bg-emerald-700 font-bold text-sm px-4 py-2 rounded shadow transition">
                                                    Resolve
                                                </button>
                                                <% } %>
                                                    <% } else { %>
                                                        <span
                                                            class="text-emerald-600 font-bold text-sm flex items-center px-3">
                                                            <i data-lucide="check-circle" class="w-4 h-4 mr-1"></i> Done
                                                        </span>
                                                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Kanban View -->
    <div id="kanban-view" class="hidden">
        <div class="flex flex-col md:flex-row gap-6 overflow-x-auto pb-4">
            <% ['new', 'investigating', 'resolved', 'closed'].forEach(status => { %>
                <div class="flex-shrink-0 w-full md:w-80 bg-gray-100 rounded-xl p-4 min-h-[500px]" 
                     ondrop="drop(event, '<%= status %>')" ondragover="allowDrop(event)">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-bold text-gray-700 uppercase text-sm"><%= status %></h3>
                        <span class="bg-gray-300 text-gray-700 px-2 py-0.5 rounded-full text-xs font-bold">
                            <%= incidents.filter(i => i.status === status).length %>
                        </span>
                    </div>
                    <div class="space-y-4">
                        <% incidents.filter(i => i.status === status).forEach(incident => { %>
                            <div class="bg-white p-4 rounded-lg shadow-sm cursor-move hover:shadow-md transition kanban-card" 
                                 draggable="true" ondragstart="drag(event)" id="kanban-<%= incident.id %>" 
                                 data-id="<%= incident.id %>"
                                 data-priority="<%= incident.priority %>"
                                 data-search="<%= incident.type.toLowerCase() %> <%= incident.description ? incident.description.toLowerCase() : '' %> <%= incident.Site ? incident.Site.name.toLowerCase() : '' %>">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                                        <%= incident.priority %>
                                    </span>
                                </div>
                                <h4 class="font-bold text-gray-800 text-sm mb-1"><%= incident.type %></h4>
                                <p class="text-xs text-gray-500 line-clamp-2"><%= incident.description %></p>
                                <div class="mt-3 pt-3 border-t border-gray-50 flex justify-between items-center">
                                    <span class="text-[10px] text-gray-400">@ <%= incident.Site ? incident.Site.name : 'Unknown' %></span>
                                    <a href="/incidents/<%= incident.id %>" class="text-blue-600 hover:text-blue-800"><i class="fas fa-external-link-alt text-[10px]"></i></a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <% if (incidents.length===0) { %>
        <div class="text-center py-12 bg-white rounded-lg shadow">
            <div class="text-gray-400 text-5xl mb-4"><i class="fas fa-clipboard-check"></i></div>
            <h3 class="text-xl font-bold text-gray-700">No Incidents Found</h3>
            <p class="text-gray-500">Everything looks clear!</p>
        </div>
    <% } %>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="mt-8 flex justify-between items-center bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-600">
                Showing <%= (currentPage - 1) * limit + 1 %> to <%= Math.min(currentPage * limit, totalIncidents) %> of <%= totalIncidents %> incidents
            </p>
            <div class="flex gap-2">
                <% if (currentPage > 1) { %>
                    <a href="/incidents?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300 transition font-bold text-sm">Previous</a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/incidents?page=<%= i %>&limit=<%= limit %>" 
                       class="px-4 py-2 rounded-lg font-bold text-sm transition <%= currentPage === i ? 'bg-red-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="/incidents?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300 transition font-bold text-sm">Next</a>
                <% } %>
            </div>
        </div>
    <% } %>

            <script>
                function setView(view) {
                    const grid = document.getElementById('grid-view');
                    const kanban = document.getElementById('kanban-view');
                    const gridBtn = document.getElementById('grid-view-btn');
                    const kanbanBtn = document.getElementById('kanban-view-btn');

                    if (view === 'kanban') {
                        grid.classList.add('hidden');
                        kanban.classList.remove('hidden');
                        kanbanBtn.classList.add('bg-white', 'shadow-sm');
                        kanbanBtn.classList.remove('text-gray-600');
                        gridBtn.classList.remove('bg-white', 'shadow-sm');
                        gridBtn.classList.add('text-gray-600');
                    } else {
                        kanban.classList.add('hidden');
                        grid.classList.remove('hidden');
                        gridBtn.classList.add('bg-white', 'shadow-sm');
                        gridBtn.classList.remove('text-gray-600');
                        kanbanBtn.classList.remove('bg-white', 'shadow-sm');
                        kanbanBtn.classList.add('text-gray-600');
                    }
                }

                function allowDrop(ev) {
                    ev.preventDefault();
                }

                function drag(ev) {
                    ev.dataTransfer.setData("text", ev.target.dataset.id);
                }

                function drop(ev, newStatus) {
                    ev.preventDefault();
                    const id = ev.dataTransfer.getData("text");
                    
                    fetch(`/incidents/${id}/status`, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'CSRF-Token': '<%= csrfToken %>'
                        },
                        body: JSON.stringify({ status: newStatus })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload(); 
                        } else {
                            alert('Error updating status: ' + data.message);
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert('Network Error');
                    });
                }

                // Simple Client-Side Filtering
                const searchInput = document.getElementById('searchInput');
                const statusFilter = document.getElementById('statusFilter');
                const priorityFilter = document.getElementById('priorityFilter');
                const gridCards = document.querySelectorAll('.incident-card');
                const kanbanCards = document.querySelectorAll('.kanban-card');

                function filterIncidents() {
                    const query = searchInput.value.toLowerCase();
                    const status = statusFilter.value;
                    const priority = priorityFilter.value;

                    // Filter Grid View
                    gridCards.forEach(card => {
                        const cardStatus = card.dataset.status;
                        const cardPriority = card.dataset.priority;
                        const cardSearch = card.dataset.search;

                        const matchQuery = cardSearch.includes(query);
                        const matchStatus = status === 'all' || cardStatus === status;
                        const matchPriority = priority === 'all' || cardPriority === priority;

                        card.style.display = (matchQuery && matchStatus && matchPriority) ? 'block' : 'none';
                    });

                    // Filter Kanban View
                    kanbanCards.forEach(card => {
                        const cardSearch = card.dataset.search;
                        const cardPriority = card.dataset.priority;
                        const matchQuery = cardSearch.includes(query);
                        const matchPriority = priority === 'all' || cardPriority === priority;
                        
                        card.style.display = (matchQuery && matchPriority) ? '' : 'none';
                    });
                }

                searchInput.addEventListener('input', filterIncidents);
                statusFilter.addEventListener('change', filterIncidents);
                priorityFilter.addEventListener('change', filterIncidents);
            </script>

            <!-- Assign Modal -->
            <div id="assignModal"
                class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
                <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm animate__animated animate__fadeInUp">
                    <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                        <h3 class="font-bold text-lg text-slate-800">Assign Incident</h3>
                        <button onclick="document.getElementById('assignModal').classList.add('hidden')"
                            class="text-slate-400 hover:text-slate-600">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>
                    <form id="assignForm" method="POST" class="p-6">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <p class="mb-4 text-sm text-slate-600">Assign <span id="modalIncidentType"
                                class="font-bold"></span> to:
                        </p>
                        <div class="mb-4">
                            <select name="userId"
                                class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                                required>
                                <% users.forEach(user=> { %>
                                    <option value="<%= user.id %>">
                                        <%= user.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="flex justify-end">
                            <button type="button"
                                onclick="document.getElementById('assignModal').classList.add('hidden')"
                                class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg mr-2">Cancel</button>
                            <button type="submit"
                                class="px-6 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md">Assign</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Resolve Modal -->
            <div id="resolveModal"
                class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
                <div
                    class="bg-white rounded-xl shadow-2xl w-full max-w-sm animate__animated animate__fadeInUp">
                    <div
                        class="px-6 py-4 border-b flex justify-between items-center bg-emerald-50 rounded-t-xl">
                        <h3 class="font-bold text-lg text-slate-800">Resolve Incident</h3>
                        <button
                            onclick="document.getElementById('resolveModal').classList.add('hidden')"
                            class="text-slate-400 hover:text-slate-600">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>
                    <form id="resolveForm" method="POST" enctype="multipart/form-data" class="p-6">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <!-- Hidden Type -->
                        <input type="hidden" name="type" value="incident">

                        <p class="mb-4 text-sm text-slate-600">You are marking this incident as
                            <strong>Resolved</strong>.
                        </p>

                        <div class="mb-4">
                            <label class="block text-slate-700 text-xs font-bold mb-2 uppercase tracking-wider">Resolution
                                Notes</label>
                            <textarea name="notes" rows="3"
                                class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none"
                                placeholder="Describe how it was fixed..."></textarea>
                        </div>

                        <div class="mb-6">
                            <label class="block text-slate-700 text-xs font-bold mb-2 uppercase tracking-wider">Evidence (Optional
                                Photo)</label>
                            <input type="file" name="evidence" accept="image/*"
                                class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                        </div>

                        <div class="flex justify-end">
                            <button type="button"
                                onclick="document.getElementById('resolveModal').classList.add('hidden')"
                                class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg mr-2">Cancel</button>
                            <button type="submit"
                                class="px-6 py-2 bg-emerald-600 text-white font-bold rounded-lg hover:bg-emerald-700 shadow-md">Mark
                                Resolved</button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function openAssignModal(id, type) {
                    document.getElementById('assignForm').action = `/incidents/${id}/assign`;
                    document.getElementById('modalIncidentType').textContent = type;
                    document.getElementById('assignModal').classList.remove('hidden');
                }

                function openResolveModal(id) {
                    document.getElementById('resolveForm').action = `/incidents/${id}/resolve`;
                    document.getElementById('resolveModal').classList.remove('hidden');
                }
            </script>

            