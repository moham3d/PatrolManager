<div class="w-full max-w-md">
    <!-- Logo & Title -->
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-brand rounded-2xl mb-4">
            <i data-lucide="shield" class="w-8 h-8 text-white"></i>
        </div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">PatrolShield</h1>
        <p class="text-slate-600">Security Workforce Management</p>
    </div>

    <!-- Login Card -->
    <div class="card">
        <h2 class="text-2xl font-semibold text-slate-900 mb-6">Sign In</h2>

        <!-- Error Message -->
        <% if (error && error.length> 0) { %>
            <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-900 p-4 rounded-lg mb-6 flex items-start">
                <i data-lucide="alert-circle" class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5"></i>
                <p class="text-sm">
                    <%= error %>
                </p>
            </div>
            <% } %>

                <!-- Login Form -->
                <form action="/login" method="POST" class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <!-- Email Field -->
                    <div>
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="admin@example.com"
                            required autofocus>
                    </div>

                    <!-- Password Field -->
                    <div>
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" name="password" class="form-input"
                            placeholder="Enter your password" required>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-full justify-center">
                        <i data-lucide="log-in" class="w-5 h-5"></i>
                        Sign In
                    </button>
                </form>

                <!-- Footer -->
                <p class="text-center text-sm text-slate-500 mt-6">
                    &copy; 2026 PatrolShield Enterprise. All rights reserved.
                </p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        lucide.createIcons();
    });
</script>