<%- include('../partials/header') %>

    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Command Center</h1>
            <p class="text-gray-600">System Overview for Administrators</p>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-blue-100 p-3 mr-4">
                    <i class="fas fa-map-marked-alt text-blue-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Total Sites</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.sites %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-green-100 p-3 mr-4">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Total Users</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.users %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-yellow-100 p-3 mr-4">
                    <i class="fas fa-user-clock text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Active Shifts</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.shifts %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-red-100 p-3 mr-4">
                    <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">New Incidents</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.incidents %>
                    </h3>
                </div>
            </div>
        </div>

        <!-- Split View: Map & Feed -->
        <div class="flex flex-col lg:flex-row gap-6 mb-8 h-auto lg:h-[600px]">
            <!-- Map (60%) -->
            <div class="w-full lg:w-3/5 bg-white rounded-lg shadow overflow-hidden relative min-h-[400px] lg:h-full">
                <%- include('../partials/live_map') %>
            </div>

            <!-- Feed (40%) -->
            <div class="w-full lg:w-2/5 bg-white rounded-lg shadow overflow-hidden flex flex-col h-[400px] lg:h-full">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
                    <h3 class="font-bold text-gray-800">Recent Activity</h3>
                    <a href="/incidents" class="text-blue-600 text-sm hover:underline">View All</a>
                </div>
                <div class="divide-y divide-gray-200 overflow-y-auto flex-grow" aria-live="polite" id="recent-activity-feed">
                    <% if (recentIncidents.length > 0) { %>
                        <% recentIncidents.forEach(incident=> { %>
                            <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition">
                                <div>
                                    <span
                                        class="text-[10px] font-bold px-2 py-1 rounded-full <%= incident.priority === 'high' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %> uppercase">
                                        <%= incident.priority %>
                                    </span>
                                    <span class="ml-2 font-bold text-gray-800 text-sm">
                                        <%= incident.type %>
                                    </span>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <i class="fas fa-map-pin mr-1"></i>
                                        <%= incident.Site ? incident.Site.name : 'Unknown Site' %>
                                        <span class="mx-1">•</span>
                                        <%= new Date(incident.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="block text-sm font-medium text-gray-900">
                                        <%= incident.reporter ? incident.reporter.name : 'System' %>
                                    </span>
                                    <span class="block text-[10px] text-gray-500">Reporter</span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <!-- Skeleton / Empty State -->
                        <div class="px-6 py-8 text-center text-gray-500 flex flex-col items-center justify-center h-full">
                            <div class="animate-pulse flex space-x-4 w-full mb-4 opacity-50">
                                <div class="rounded-full bg-slate-200 h-10 w-10"></div>
                                <div class="flex-1 space-y-6 py-1">
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                    <div class="space-y-3">
                                        <div class="grid grid-cols-3 gap-4">
                                            <div class="h-2 bg-slate-200 rounded col-span-2"></div>
                                            <div class="h-2 bg-slate-200 rounded col-span-1"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p class="text-sm">No recent activity to report.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Bottom Widgets -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Guard Performance -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Top Guards (Today)</h3>
                <% if (topGuards && topGuards.length > 0) { %>
                    <ul class="space-y-3">
                        <% topGuards.forEach((stat, index) => { %>
                            <li class="flex justify-between items-center">
                                <div class="flex items-center">
                                    <span class="text-gray-400 font-bold w-6">#<%= index + 1 %></span>
                                    <span class="font-medium text-gray-700"><%= stat.guard.name %></span>
                                </div>
                                <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">
                                    <%= stat.dataValues.count %> Patrols
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="text-sm text-gray-500 italic">No patrol data yet.</p>
                <% } %>
            </div>

            <!-- Site Status -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Problem Sites</h3>
                <% if (problemSites && problemSites.length > 0) { %>
                    <ul class="space-y-3">
                        <% problemSites.forEach(site => { %>
                            <li class="flex justify-between items-center">
                                <span class="font-medium text-gray-700"><%= site.name %></span>
                                <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full">
                                    <%= site.Incidents.length %> Alert(s)
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="text-center py-4 text-green-600">
                        <i class="fas fa-check-circle fa-2x mb-2"></i>
                        <p class="text-sm font-bold">All Sites Clear</p>
                    </div>
                <% } %>
            </div>

            <!-- System Health -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">System Health</h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-600">Server Uptime</span>
                            <span class="font-bold text-gray-800"><%= Math.floor(systemHealth.uptime / 60) %> min</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-blue-600 h-2 rounded-full" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Database</span>
                        <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded">
                            <i class="fas fa-database mr-1"></i> <%= systemHealth.dbStatus %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Last Backup</span>
                        <span class="text-xs text-gray-500"><%= new Date(systemHealth.lastBackup).toLocaleTimeString() %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Row -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="font-bold text-gray-800 mb-4">Quick Actions</h3>
            <div class="flex flex-wrap gap-4">
                <a href="/users/create"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-blue-500 text-white flex items-center justify-center mr-3">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Add User</span>
                        <span class="text-xs text-gray-500">Create new staff</span>
                    </div>
                </a>
                <a href="/sites/create"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-indigo-500 text-white flex items-center justify-center mr-3">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Add Site</span>
                        <span class="text-xs text-gray-500">Register location</span>
                    </div>
                </a>
                <a href="/admin/roles"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-orange-500 text-white flex items-center justify-center mr-3">
                        <i class="fas fa-user-tag"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Manage Roles</span>
                        <span class="text-xs text-gray-500">Configure permissions</span>
                    </div>
                </a>
                <a href="/reports"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-purple-500 text-white flex items-center justify-center mr-3">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Reports</span>
                        <span class="text-xs text-gray-500">View analytics</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>