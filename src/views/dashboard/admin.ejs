
    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Command Center</h1>
            <p class="text-gray-600">System Overview for Administrators</p>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-blue-100 p-3 mr-4">
                    <i class="fas fa-map-marked-alt text-blue-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Total Sites</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.sites %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-green-100 p-3 mr-4">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Total Users</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.users %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-yellow-100 p-3 mr-4">
                    <i class="fas fa-user-clock text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Active Shifts</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.shifts %>
                    </h3>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow p-6 flex items-center hover:-translate-y-1 transition duration-300">
                <div class="rounded-full bg-red-100 p-3 mr-4">
                    <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">New Incidents</p>
                    <h3 class="text-2xl font-bold text-gray-800">
                        <%= stats.incidents %>
                    </h3>
                </div>
            </div>
        </div>

        <!-- Split View: Map & Feed -->
        <div class="flex flex-col lg:flex-row gap-6 mb-8 h-auto lg:h-[600px]">
            <!-- Map (60%) -->
            <div class="w-full lg:w-3/5 bg-white rounded-lg shadow overflow-hidden relative min-h-[400px] lg:h-full">
                <%- include('../partials/live_map') %>
            </div>

            <!-- Feed (40%) -->
            <div class="w-full lg:w-2/5 bg-white rounded-lg shadow overflow-hidden flex flex-col h-[400px] lg:h-full">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
                    <h3 class="font-bold text-gray-800">Recent Activity</h3>
                    <a href="/incidents" class="text-blue-600 text-sm hover:underline">View All</a>
                </div>
                <div class="divide-y divide-gray-200 overflow-y-auto flex-grow" aria-live="polite" id="recent-activity-feed">
                    <% if (recentIncidents.length > 0) { %>
                        <% recentIncidents.forEach(incident=> { %>
                            <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition">
                                <div>
                                    <span
                                        class="text-[10px] font-bold px-2 py-1 rounded-full <%= incident.priority === 'high' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %> uppercase">
                                        <%= incident.priority %>
                                    </span>
                                    <span class="ml-2 font-bold text-gray-800 text-sm">
                                        <%= incident.type %>
                                    </span>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <i class="fas fa-map-pin mr-1"></i>
                                        <%= incident.Site ? incident.Site.name : 'Unknown Site' %>
                                        <span class="mx-1">•</span>
                                        <%= new Date(incident.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="block text-sm font-medium text-gray-900">
                                        <%= incident.reporter ? incident.reporter.name : 'System' %>
                                    </span>
                                    <span class="block text-[10px] text-gray-500">Reporter</span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <!-- Skeleton / Empty State -->
                        <div class="px-6 py-8 text-center text-gray-500 flex flex-col items-center justify-center h-full">
                            <div class="animate-pulse flex space-x-4 w-full mb-4 opacity-50">
                                <div class="rounded-full bg-slate-200 h-10 w-10"></div>
                                <div class="flex-1 space-y-6 py-1">
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                    <div class="space-y-3">
                                        <div class="grid grid-cols-3 gap-4">
                                            <div class="h-2 bg-slate-200 rounded col-span-2"></div>
                                            <div class="h-2 bg-slate-200 rounded col-span-1"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p class="text-sm">No recent activity to report.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Bottom Widgets -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Guard Performance -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Top Guards (Today)</h3>
                <% if (topGuards && topGuards.length > 0) { %>
                    <ul class="space-y-3">
                        <% topGuards.forEach((stat, index) => { %>
                            <li class="flex justify-between items-center">
                                <div class="flex items-center">
                                    <span class="text-gray-400 font-bold w-6">#<%= index + 1 %></span>
                                    <span class="font-medium text-gray-700"><%= stat.guard.name %></span>
                                </div>
                                <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full">
                                    <%= stat.dataValues.count %> Patrols
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="text-sm text-gray-500 italic">No patrol data yet.</p>
                <% } %>
            </div>

            <!-- Site Status -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Problem Sites</h3>
                <% if (problemSites && problemSites.length > 0) { %>
                    <ul class="space-y-3">
                        <% problemSites.forEach(site => { %>
                            <li class="flex justify-between items-center">
                                <span class="font-medium text-gray-700"><%= site.name %></span>
                                <span class="bg-red-100 text-red-800 text-xs font-bold px-2 py-1 rounded-full">
                                    <%= site.Incidents.length %> Alert(s)
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="text-center py-4 text-green-600">
                        <i class="fas fa-check-circle fa-2x mb-2"></i>
                        <p class="text-sm font-bold">All Sites Clear</p>
                    </div>
                <% } %>
            </div>

            <!-- System Health -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">System Health</h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-600">Server Uptime</span>
                            <span class="font-bold text-gray-800"><%= Math.floor(systemHealth.uptime / 60) %> min</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-blue-600 h-2 rounded-full" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Database</span>
                        <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded">
                            <i class="fas fa-database mr-1"></i> <%= systemHealth.dbStatus %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Last Backup</span>
                        <span class="text-xs text-gray-500"><%= new Date(systemHealth.lastBackup).toLocaleTimeString() %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Row -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="font-bold text-gray-800 mb-4">Quick Actions</h3>
            <div class="flex flex-wrap gap-4">
                <button onclick="document.getElementById('createUserModal').classList.remove('hidden')"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200 text-left">
                    <div class="w-10 h-10 rounded-full bg-blue-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="user-plus"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Add User</span>
                        <span class="text-xs text-gray-500">Create new staff</span>
                    </div>
                </button>
                <button onclick="document.getElementById('createSiteModal').classList.remove('hidden')"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200 text-left">
                    <div class="w-10 h-10 rounded-full bg-indigo-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="building-2"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Add Site</span>
                        <span class="text-xs text-gray-500">Register location</span>
                    </div>
                </button>
                <a href="/admin/roles"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-orange-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="shield-check"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Manage Roles</span>
                        <span class="text-xs text-gray-500">Configure permissions</span>
                    </div>
                </a>
                <a href="/reports"
                    class="flex-1 min-w-[200px] py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg flex items-center transition border border-gray-200">
                    <div class="w-10 h-10 rounded-full bg-purple-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="bar-chart-3"></i>
                    </div>
                    <div>
                        <span class="block font-bold text-gray-800">Reports</span>
                        <span class="text-xs text-gray-500">View analytics</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Create User Modal -->
    <div id="createUserModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md animate__animated animate__fadeInUp">
            <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800 flex items-center">
                    <i data-lucide="user-plus" class="w-5 h-5 mr-2 text-blue-600"></i> Create New User
                </h3>
                <button onclick="document.getElementById('createUserModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form action="/users" method="POST" class="p-6 space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Full Name</label>
                    <input type="text" name="name" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Email Address</label>
                    <input type="email" name="email" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Password</label>
                    <input type="password" name="password" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Role</label>
                    <select name="roleId" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                        <% if (locals.roles) { %>
                            <% roles.forEach(r => { %>
                                <option value="<%= r.id %>"><%= r.displayName || r.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="flex justify-end pt-4 gap-3">
                    <button type="button" onclick="document.getElementById('createUserModal').classList.add('hidden')"
                        class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md transition">
                        Create User
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Create Site Modal -->
    <div id="createSiteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col animate__animated animate__fadeInUp">
            <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800 flex items-center">
                    <i data-lucide="building-2" class="w-5 h-5 mr-2 text-blue-600"></i> Create New Site
                </h3>
                <button onclick="document.getElementById('createSiteModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <div class="overflow-y-auto p-6">
                <form action="/sites" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <div class="mb-4">
                                <label class="block text-slate-700 text-sm font-bold mb-2" for="name">
                                    Site Name
                                </label>
                                <input
                                    class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                                    name="name" type="text" placeholder="e.g. Headquarters" required>
                            </div>

                            <div class="mb-4">
                                <label class="block text-slate-700 text-sm font-bold mb-2" for="address">
                                    Address
                                </label>
                                <input
                                    class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                                    name="address" type="text" placeholder="e.g. 123 Security Blvd">
                            </div>

                            <div class="mb-4">
                                <label class="block text-slate-700 text-sm font-bold mb-2" for="details">
                                    Details / Notes
                                </label>
                                <textarea
                                    class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                                    name="details" rows="4"></textarea>
                            </div>

                            <!-- GPS Storage -->
                            <input type="hidden" id="dash-latitude" name="lat" value="">
                            <input type="hidden" id="dash-longitude" name="lng" value="">
                            <input type="hidden" id="dash-boundaries" name="boundaries" value="">
                        </div>

                        <div>
                            <label class="block text-slate-700 text-sm font-bold mb-2">
                                Site Location & Geofence <span class="text-rose-500">*</span>
                            </label>
                            <div id="dash-create-site-map" class="h-64 rounded-lg border border-slate-200 shadow-inner"></div>
                            <div id="dash-coords-display" class="mt-2 text-xs text-slate-500 italic">Place a marker or draw a polygon.</div>
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-3 border-t pt-4">
                        <button type="button" onclick="document.getElementById('createSiteModal').classList.add('hidden')"
                            class="px-6 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg transition">
                            Cancel
                        </button>
                        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-8 rounded-lg shadow transition"
                            type="submit">
                            Create Site
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();
            
            // Map logic for Dashboard Create Site Modal
            let dashCreateMap;
            let drawnItems;
            
            window.initDashCreateMap = function() {
                if (dashCreateMap) {
                    setTimeout(() => dashCreateMap.invalidateSize(), 100);
                    return;
                }
                
                dashCreateMap = L.map('dash-create-site-map').setView([30.0444, 31.2357], 12);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(dashCreateMap);

                drawnItems = new L.FeatureGroup();
                dashCreateMap.addLayer(drawnItems);

                const drawControl = new L.Control.Draw({
                    draw: {
                        polygon: true,
                        polyline: false,
                        rectangle: false,
                        circle: false,
                        circlemarker: false,
                        marker: true
                    },
                    edit: {
                        featureGroup: drawnItems
                    }
                });
                dashCreateMap.addControl(drawControl);

                const latInput = document.getElementById('dash-latitude');
                const lngInput = document.getElementById('dash-longitude');
                const boundariesInput = document.getElementById('dash-boundaries');
                const coordsDisplay = document.getElementById('dash-coords-display');

                dashCreateMap.on(L.Draw.Event.CREATED, function (event) {
                    const layer = event.layer;
                    drawnItems.clearLayers();
                    drawnItems.addLayer(layer);

                    if (event.layerType === 'marker') {
                        const latlng = layer.getLatLng();
                        latInput.value = latlng.lat.toFixed(6);
                        lngInput.value = latlng.lng.toFixed(6);
                        coordsDisplay.textContent = `Location: ${latlng.lat.toFixed(6)}, ${latlng.lng.toFixed(6)}`;
                    } else if (event.layerType === 'polygon') {
                        const latlngs = layer.getLatLngs()[0];
                        boundariesInput.value = JSON.stringify(latlngs);
                        const center = layer.getBounds().getCenter();
                        latInput.value = center.lat.toFixed(6);
                        lngInput.value = center.lng.toFixed(6);
                        coordsDisplay.textContent = `Area Set (Center: ${center.lat.toFixed(6)}, ${center.lng.toFixed(6)})`;
                    }
                });
            };

            // Watch for modal open
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === "class") {
                        const target = mutation.target;
                        if (target.id === 'createSiteModal' && !target.classList.contains("hidden")) {
                            window.initDashCreateMap();
                        }
                    }
                });
            });
            observer.observe(document.getElementById('createSiteModal'), { attributes: true });
        });
    </script>

    