<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-slate-50 min-h-screen" x-data="{ sidebarOpen: false }">
    <!-- Sidebar -->
    <%- include('../partials/sidebar') %>

    <!-- Main Content Area -->
    <div class="md:ml-64 min-h-screen flex flex-col relative">
            <!-- Top Navigation -->
            <%- include('../partials/top-nav') %>

                <!-- Main Content -->
                <main class="flex-1 overflow-y-auto p-6 scroll-smooth">
                    <!-- Flash Messages -->
                    <div id="flash-messages" class="mb-6">
                        <% if (typeof success !=='undefined' && success && success.length> 0) { %>
                            <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-900 p-4 rounded-lg mb-4 flex items-start"
                                role="alert">
                                <i data-lucide="check-circle" class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5"></i>
                                <div class="flex-1">
                                    <p class="font-medium">Success</p>
                                    <p class="text-sm">
                                        <%= success %>
                                    </p>
                                </div>
                                <button onclick="this.parentElement.remove()"
                                    class="ml-4 text-emerald-700 hover:text-emerald-900">
                                    <i data-lucide="x" class="w-5 h-5"></i>
                                </button>
                            </div>
                            <% } %>

                                <% if (typeof error !=='undefined' && error && error.length> 0) { %>
                                    <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-900 p-4 rounded-lg mb-4 flex items-start"
                                        role="alert">
                                        <i data-lucide="alert-circle" class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5"></i>
                                        <div class="flex-1">
                                            <p class="font-medium">Error</p>
                                            <p class="text-sm">
                                                <%= error %>
                                            </p>
                                        </div>
                                        <button onclick="this.parentElement.remove()"
                                            class="ml-4 text-rose-700 hover:text-rose-900">
                                            <i data-lucide="x" class="w-5 h-5"></i>
                                        </button>
                                    </div>
                                    <% } %>

                                        <% if (typeof warning !=='undefined' && warning && warning.length> 0) { %>
                                            <div class="bg-amber-50 border-l-4 border-amber-500 text-amber-900 p-4 rounded-lg mb-4 flex items-start"
                                                role="alert">
                                                <i data-lucide="alert-triangle"
                                                    class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5"></i>
                                                <div class="flex-1">
                                                    <p class="font-medium">Warning</p>
                                                    <p class="text-sm">
                                                        <%= warning %>
                                                    </p>
                                                </div>
                                                <button onclick="this.parentElement.remove()"
                                                    class="ml-4 text-amber-700 hover:text-amber-900">
                                                    <i data-lucide="x" class="w-5 h-5"></i>
                                                </button>
                                            </div>
                                            <% } %>
                    </div>

                    <!-- Page Content -->
                    <%- body %>
                </main>
        </div>

        <!-- Scripts -->
        <%- include('../partials/scripts') %>
        <%- include('../partials/walkie_talkie') %>

            <script>
                // Auto-dismiss flash messages after 5 seconds
                document.addEventListener('DOMContentLoaded', function () {
                    const messages = document.querySelectorAll('#flash-messages > div');
                    messages.forEach(function (message) {
                        setTimeout(function () {
                            message.style.opacity = '0';
                            message.style.transition = 'opacity 300ms';
                            setTimeout(function () {
                                message.remove();
                            }, 300);
                        }, 5000);
                    });
                });
            </script>
</body>

</html>