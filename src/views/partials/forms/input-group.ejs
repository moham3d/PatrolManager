<!-- Input Group Component -->
<%
const field = locals.field || {};
const name = field.name || '';
const type = field.type || 'text';
const label = field.label || '';
const placeholder = field.placeholder || '';
const value = field.value || '';
const required = field.required || false;
const disabled = field.disabled || false;
const error = field.error || '';
const help = field.help || '';
const icon = field.icon || null;
const maxLength = field.maxLength || null;
const rows = field.rows || null;
%>

<div class="input-group <%= error ? 'input-group--error' : '' %>">
    <% if (label) { %>
        <label for="<%= name %>" class="input-group__label <%= required ? 'input-group__label--required' : '' %>">
            <%= label %>
        </label>
    <% } %>

    <div class="input-group__wrapper">
        <% if (icon) { %>
            <div class="input-group__icon">
                <i data-lucide="<%= icon %>"></i>
            </div>
        <% } %>

        <% if (type === 'textarea') { %>
            <textarea
                id="<%= name %>"
                name="<%= name %>"
                class="input-group__input"
                placeholder="<%= placeholder %>"
                <%= required ? 'required' : '' %>
                <%= disabled ? 'disabled' : '' %>
                <%= rows ? `rows="${rows}"` : '' %>
            ><%= value %></textarea>
        <% } else { %>
            <input
                type="<%= type %>"
                id="<%= name %>"
                name="<%= name %>"
                class="input-group__input <%= icon ? 'input-group__input--with-icon' : '' %>"
                placeholder="<%= placeholder %>"
                value="<%= value %>"
                <%= required ? 'required' : '' %>
                <%= disabled ? 'disabled' : '' %>
                <%= maxLength ? `maxlength="${maxLength}"` : '' %>
            >
        <% } %>
    </div>

    <% if (error) { %>
        <div class="input-group__error">
            <i data-lucide="alert-circle"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (help && !error) { %>
        <div class="input-group__help">
            <i data-lucide="info"></i>
            <span><%= help %></span>
        </div>
    <% } %>
</div>

<style>
.input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.input-group__label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    display: block;
}

.input-group__label--required::after {
    content: ' *';
    color: var(--color-danger-500);
}

.input-group__wrapper {
    position: relative;
}

.input-group__icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
}

.input-group__icon i {
    width: 18px;
    height: 18px;
}

.input-group__input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: var(--text-base);
    font-family: var(--font-primary);
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    resize: vertical;
}

.input-group__input--with-icon {
    padding-left: 2.75rem;
}

.input-group__input::placeholder {
    color: var(--text-tertiary);
}

.input-group__input:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
}

.input-group__input:disabled {
    background-color: var(--bg-hover);
    color: var(--text-tertiary);
    cursor: not-allowed;
}

.input-group__input:focus ~ .input-group__icon {
    color: var(--color-primary-500);
}

.input-group--error .input-group__input {
    border-color: var(--color-danger-500);
}

.input-group--error .input-group__input:focus {
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.input-group--error .input-group__icon {
    color: var(--color-danger-500);
}

.input-group__error {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    color: var(--color-danger-500);
}

.input-group__error i {
    width: 14px;
    height: 14px;
}

.input-group__help {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
}

.input-group__help i {
    width: 14px;
    height: 14px;
}

/* Character Counter */
.input-group__counter {
    position: absolute;
    right: 1rem;
    bottom: 0.75rem;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
}

/* Responsive */
@media (max-width: 480px) {
    .input-group__input {
        font-size: 16px; /* Prevent iOS zoom */
    }
}
</style>
