<!-- Badge Component -->
<%
const badge = locals.badge || {};
const text = badge.text || '';
const variant = badge.variant || 'primary'; // 'primary' | 'success' | 'warning' | 'danger' | 'info' | 'light'
const size = badge.size || 'md'; // 'sm' | 'md' | 'lg'
const pill = badge.pill !== false; // default true
const icon = badge.icon || null;
%>

<span class="badge badge--<%= variant %> badge--<%= size %> <%= pill ? 'badge--pill' : '' %>">
    <% if (icon) { %>
        <i data-lucide="<%= icon %>"></i>
    <% } %>
    <span><%= text %></span>
</span>

<style>
.badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    font-family: var(--font-primary);
    white-space: nowrap;
}

/* Variants */
.badge--primary {
    background-color: rgba(14, 165, 233, 0.1);
    color: var(--color-primary-500);
}

.badge--success {
    background-color: rgba(16, 185, 129, 0.1);
    color: var(--color-success-500);
}

.badge--warning {
    background-color: rgba(249, 115, 22, 0.1);
    color: var(--color-warning-500);
}

.badge--danger {
    background-color: rgba(239, 68, 68, 0.1);
    color: var(--color-danger-500);
}

.badge--info {
    background-color: rgba(14, 165, 233, 0.1);
    color: var(--color-primary-500);
}

.badge--light {
    background-color: rgba(148, 163, 184, 0.1);
    color: var(--text-secondary);
}

/* Sizes */
.badge--sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem; /* 10px */
}

.badge--md {
    padding: 0.375rem 0.75rem;
    font-size: var(--text-xs); /* 12px */
}

.badge--lg {
    padding: 0.5rem 1rem;
    font-size: var(--text-sm); /* 14px */
}

/* Pill Shape */
.badge--pill {
    border-radius: var(--radius-full);
}

.badge:not(.badge--pill) {
    border-radius: var(--radius-sm);
}

/* Icon sizing */
.badge i {
    width: 14px;
    height: 14px;
}

.badge--sm i {
    width: 12px;
    height: 12px;
}

.badge--lg i {
    width: 16px;
    height: 16px;
}
</style>
