<!-- Top Navigation Bar -->
<header class="sticky top-0 z-30 bg-white border-b border-slate-200 h-16">
    <div class="flex items-center justify-between h-full px-6">
        <!-- Mobile Menu Button -->
        <button @click="sidebarOpen = !sidebarOpen" class="md:hidden text-slate-600 hover:text-slate-900">
            <i data-lucide="menu" class="w-6 h-6"></i>
        </button>

        <!-- Page Title (optional, can be set per page) -->
        <div class="flex-1 md:ml-0 ml-4">
            <% if (typeof pageTitle !=='undefined' ) { %>
                <h1 class="text-xl font-semibold text-slate-900">
                    <%= pageTitle %>
                </h1>
                <% } %>
        </div>

        <!-- Right Side Actions -->
        <div class="flex items-center space-x-4">
            <!-- Notifications (placeholder for future) -->
            <button class="relative text-slate-600 hover:text-slate-900">
                <i data-lucide="bell" class="w-5 h-5"></i>
                <!-- Notification badge -->
                <span
                    class="absolute -top-1 -right-1 w-4 h-4 bg-alert rounded-full text-xs text-white flex items-center justify-center">
                    3
                </span>
            </button>

            <!-- User Menu -->
            <% if (typeof user !=='undefined' && user) { %>
                <div class="hidden md:flex items-center space-x-3">
                    <div class="text-right">
                        <p class="text-sm font-medium text-slate-900">
                            <%= user.name %>
                        </p>
                        <p class="text-xs text-slate-500">
                            <%= user.Role ? user.Role.name : 'User' %>
                        </p>
                    </div>
                    <div
                        class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-semibold">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                </div>
                <% } %>
        </div>
    </div>
</header>