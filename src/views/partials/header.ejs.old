<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'PatrolShield' %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Leaflet Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        .leaflet-container {
            z-index: 10;
        }
    </style>
    <%- include('socketClient') %>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
    <nav class="bg-blue-900 text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-6 py-2">
            <div class="flex justify-between items-center">
                <a href="/" class="text-xl font-bold flex items-center space-x-2">
                    <i class="fas fa-shield-alt"></i>
                    <span>PatrolShield</span>
                </a>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" class="md:hidden text-white focus:outline-none hover:text-blue-200">
                    <i class="fas fa-bars fa-lg"></i>
                </button>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-6">
                    <div class="space-x-4">
                        <% 
                        const currentRole = (typeof user !== 'undefined' && user && user.Role) ? user.Role.name.toLowerCase() : '';
                        const canManage = ['admin', 'manager', 'supervisor'].includes(currentRole);
                        const canViewReports = ['admin', 'manager'].includes(currentRole);
                        %>

                        <% if (canManage) { %>
                            <a href="/sites" class="hover:text-blue-200 transition-colors">Sites</a>
                            <a href="/patrols" class="hover:text-blue-200 transition-colors">Patrols</a>
                            <a href="/incidents" class="hover:text-blue-200 transition-colors">Incidents</a>
                        <% } %>

                        <% if (canViewReports) { %>
                            <a href="/reports" class="hover:text-blue-200 transition-colors">Data & Reports</a>
                        <% } %>

                        <% if (canManage) { %>
                            <a href="/shifts" class="hover:text-blue-200 transition-colors">Shifts</a>
                            <a href="/schedules" class="hover:text-blue-200 transition-colors">Rostering</a>
                        <% } else if (currentRole === 'guard') { %>
                            <a href="/shifts/my-schedule" class="hover:text-blue-200 transition-colors">My Schedule</a>
                        <% } %>

                        <% if (['admin', 'manager'].includes(currentRole)) { %>
                            <a href="/users" class="hover:text-blue-200 transition-colors">Users</a>
                        <% } %>

                        <% if (currentRole === 'admin') { %>
                            <a href="/admin/roles" class="hover:text-blue-200 transition-colors">Roles</a>
                        <% } %>

                        <% if (typeof user !=='undefined' && user && user.Role) { %>
                            <% if (['admin', 'manager' ].includes(user.Role.name.toLowerCase())) { %>
                                <a href="/docs/admin" class="hover:text-blue-200 transition-colors"><i
                                        class="fas fa-book"></i> Manual</a>
                            <% } else { %>
                                <a href="/docs/guard" class="hover:text-blue-200 transition-colors"><i
                                        class="fas fa-book"></i> Manual</a>
                            <% } %>
                        <% } else { %>
                            <a href="/docs/manual" class="hover:text-blue-200 transition-colors"><i
                                    class="fas fa-book"></i> Manual</a>
                        <% } %>
                    </div>
                    <div class="border-l border-blue-700 pl-6">
                        <% if (typeof user !=='undefined' && user) { %>
                            <span class="mr-4">
                                <%= user.name %>
                            </span>
                            <a href="/logout"
                                class="text-sm bg-blue-700 px-3 py-1 rounded hover:bg-blue-600 transition-colors">Logout</a>
                            <% } else { %>
                                <a href="/login"
                                    class="text-sm bg-blue-700 px-3 py-1 rounded hover:bg-blue-600 transition-colors">Login</a>
                                <% } %>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu (Hidden by default) -->
            <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-blue-800">
                <div class="flex flex-col space-y-1 mt-4">
                    <% 
                    const mRole = (typeof user !== 'undefined' && user && user.Role) ? user.Role.name.toLowerCase() : '';
                    const mCanManage = ['admin', 'manager', 'supervisor'].includes(mRole);
                    const mCanViewReports = ['admin', 'manager'].includes(mRole);
                    %>

                    <% if (mCanManage) { %>
                        <a href="/sites" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-building w-6"></i> Sites</a>
                        <a href="/patrols" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-walking w-6"></i> Patrols</a>
                        <a href="/incidents" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-exclamation-triangle w-6"></i> Incidents</a>
                    <% } %>

                    <% if (mCanViewReports) { %>
                        <a href="/reports" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-chart-bar w-6"></i> Data & Reports</a>
                    <% } %>

                    <% if (mCanManage) { %>
                        <a href="/shifts" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-clock w-6"></i> Shifts</a>
                        <a href="/schedules" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-calendar-alt w-6"></i> Rostering</a>
                    <% } else if (mRole === 'guard') { %>
                        <a href="/shifts/my-schedule" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-calendar-check w-6"></i> My Schedule</a>
                    <% } %>

                    <% if (['admin', 'manager'].includes(mRole)) { %>
                        <a href="/users" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-users w-6"></i> Users</a>
                    <% } %>

                    <% if (mRole === 'admin') { %>
                        <a href="/admin/roles" class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i class="fas fa-user-tag w-6"></i> Roles</a>
                    <% } %>

                    <% if (typeof user !=='undefined' && user && user.Role) { %>
                        <% if (['admin', 'manager' ].includes(user.Role.name.toLowerCase())) { %>
                            <a href="/docs/admin"
                                class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i
                                    class="fas fa-book w-6"></i> Manual</a>
                        <% } else { %>
                            <a href="/docs/guard"
                                class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i
                                    class="fas fa-book w-6"></i> Manual</a>
                        <% } %>
                    <% } else { %>
                        <a href="/docs/manual"
                            class="block hover:bg-blue-800 px-4 py-3 rounded-lg transition-colors font-bold flex items-center"><i
                                class="fas fa-book w-6"></i> Manual</a>
                    <% } %>

                    <div class="border-t border-blue-800 pt-3 mt-2">
                        <% if (typeof user !=='undefined' && user) { %>
                            <div class="px-4 py-3 mb-2 text-blue-200 text-sm flex items-center">
                                <i class="fas fa-user-circle mr-2"></i> Signed in as <%= user.name %>
                            </div>
                            <a href="/logout"
                                class="block bg-blue-700 hover:bg-blue-600 px-4 py-3 rounded-lg text-center font-bold transition-colors">Logout</a>
                        <% } else { %>
                            <a href="/login"
                                class="block bg-blue-700 hover:bg-blue-600 px-4 py-3 rounded-lg text-center font-bold transition-colors">Login</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu-overlay" style="display: none;" class="fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-menu-overlay');

            if (btn && menu && overlay) {
                const toggleMenu = () => {
                    const isHidden = menu.classList.contains('hidden');
                    if (isHidden) {
                        menu.classList.remove('hidden');
                        overlay.style.display = 'block';
                        document.body.classList.add('overflow-hidden');
                    } else {
                        menu.classList.add('hidden');
                        overlay.style.display = 'none';
                        document.body.classList.remove('overflow-hidden');
                    }
                };

                btn.addEventListener('click', toggleMenu);
                overlay.addEventListener('click', toggleMenu);
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <main class="container mx-auto px-6 py-8 flex-grow">