
    <div class="max-w-6xl mx-auto mt-8 px-4">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-semibold text-gray-800">Shift Logs</h1>
            <% if (['admin', 'manager', 'supervisor'].includes(user.Role.name.toLowerCase())) { %>
                <button onclick="document.getElementById('createShiftModal').classList.remove('hidden')"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow transition flex items-center">
                    <i data-lucide="calendar-plus" class="w-5 h-5 mr-2"></i> Assign Shift
                </button>
                <% } %>
        </div>

        <div class="bg-white shadow overflow-hidden sm:rounded-xl border border-slate-100 mb-8">
            <table class="min-w-full divide-y divide-slate-200">
                <thead>
                    <tr>
                        <th class="px-6 py-3 bg-slate-50 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Officer</th>
                        <th class="px-6 py-3 bg-slate-50 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Site</th>
                        <th class="px-6 py-3 bg-slate-50 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 bg-slate-50 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Schedule</th>
                        <th class="px-6 py-3 bg-slate-50 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    <% shifts.forEach(shift=> { %>
                        <tr class="hover:bg-slate-50 transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center text-blue-600 font-bold">
                                            <%= shift.user ? shift.user.name.charAt(0) : '?' %>
                                        </div>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-slate-900">
                                            <%= shift.user ? shift.user.name : 'Unknown User' %>
                                        </div>
                                        <div class="text-xs text-slate-500">
                                            <%= shift.user && shift.user.Role ? (shift.user.Role.displayName || shift.user.Role.name) : '---' %>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-medium">
                                <%= shift.site ? shift.site.name : 'Unassigned' %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <% if(shift.status==='active' ) { %>
                                    <span class="px-2.5 py-0.5 inline-flex text-[10px] font-bold leading-5 rounded-full bg-emerald-100 text-emerald-800 uppercase tracking-wider">Active</span>
                                <% } else if(shift.status==='completed' ) { %>
                                    <span class="px-2.5 py-0.5 inline-flex text-[10px] font-bold leading-5 rounded-full bg-slate-100 text-slate-800 uppercase tracking-wider">Completed</span>
                                <% } else { %>
                                    <span class="px-2.5 py-0.5 inline-flex text-[10px] font-bold leading-5 rounded-full bg-blue-100 text-blue-800 uppercase tracking-wider"><%= shift.status %></span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                <div class="font-bold text-slate-700 flex items-center">
                                    <i data-lucide="calendar" class="w-3 h-3 mr-1"></i>
                                    <%= new Date(shift.startTime).toLocaleDateString() %>
                                </div>
                                <div class="text-xs flex items-center">
                                    <i data-lucide="clock" class="w-3 h-3 mr-1"></i>
                                    <%= new Date(shift.startTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %> - 
                                    <%= new Date(shift.endTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <% if (['admin', 'manager'].includes(user.Role.name.toLowerCase())) { %>
                                    <form action="/shifts/<%= shift.id %>/delete" method="POST" class="inline-block"
                                        onsubmit="return confirm('Delete this shift?');">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="text-rose-600 hover:text-rose-900 transition">
                                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                            <% if(shifts.length===0) { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-slate-400 italic">
                                        <i data-lucide="clock-9" class="w-12 h-12 mx-auto mb-4 opacity-20"></i>
                                        <p>No shifts recorded.</p>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Shift Modal -->
    <div id="createShiftModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md animate__animated animate__fadeInUp">
            <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800 flex items-center">
                    <i data-lucide="calendar-plus" class="w-5 h-5 mr-2 text-blue-600"></i> Assign Shift
                </h3>
                <button onclick="document.getElementById('createShiftModal').classList.add('hidden')"
                    class="text-slate-400 hover:text-slate-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form action="/shifts/create" method="POST" class="p-6 space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Guard</label>
                    <select name="userId"
                        class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                        required>
                        <% users.forEach(u=> { %>
                            <option value="<%= u.id %>">
                                <%= u.name %> (<%= u.email %>)
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Site</label>
                    <select name="siteId"
                        class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                        required>
                        <% sites.forEach(s=> { %>
                            <option value="<%= s.id %>">
                                <%= s.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Date</label>
                    <input type="date" name="date"
                        class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                        required>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-slate-700 text-sm font-bold mb-2">Start Time</label>
                        <input type="time" name="startTime"
                            class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                            required>
                    </div>
                    <div>
                        <label class="block text-slate-700 text-sm font-bold mb-2">End Time</label>
                        <input type="time" name="endTime"
                            class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"
                            required>
                    </div>
                </div>
                <div class="flex justify-end pt-4 gap-3">
                    <button type="button" onclick="document.getElementById('createShiftModal').classList.add('hidden')"
                        class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit"
                        class="px-6 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md transition">Assign</button>
                </div>
            </form>
        </div>
    </div>

    