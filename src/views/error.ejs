<%- include('partials/header') %>

<div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <div class="bg-white p-8 rounded-lg shadow-md max-w-lg w-full">
        <div class="text-red-500 mb-4">
            <i class="fas fa-exclamation-triangle fa-5x"></i>
        </div>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Something went wrong</h1>
        <p class="text-gray-600 mb-6"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while loading this page.' %></p>
        
        <% if (typeof error !== 'undefined' && error && error.stack) { %>
            <div class="text-left bg-gray-100 p-4 rounded mb-6 overflow-x-auto max-h-48">
                <pre class="text-xs text-red-700"><code><%= error.stack %></code></pre>
            </div>
        <% } %>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button onclick="window.location.reload()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded transition-colors flex items-center justify-center">
                <i class="fas fa-sync-alt mr-2"></i> Retry
            </button>
            <a href="/" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-6 rounded transition-colors flex items-center justify-center">
                <i class="fas fa-home mr-2"></i> Go to Dashboard
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>