<%- include('../../partials/header') %>

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800"><%= title %></h1>
        <% if (isSystemRole) { %>
            <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full flex items-center">
                <i class="fas fa-lock mr-1"></i> System Role
            </span>
        <% } %>
    </div>

    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="p-6">
            <% if (isSystemRole) { %>
                <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-info-circle text-blue-500"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-blue-700">
                                This is a system role. You can modify permissions, but the role name cannot be changed to ensure system stability.
                            </p>
                        </div>
                    </div>
                </div>
            <% } %>

            <form action="/admin/roles/<%= role.id %>/edit" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-4">
                    <label for="name" class="block text-gray-700 text-sm font-bold mb-2">Role Code</label>
                    <input type="text" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 bg-gray-50 leading-tight focus:outline-none" 
                           id="name" name="name"
                           value="<%= role.name %>" readonly>
                    <p class="text-gray-400 text-[10px] mt-1 italic">Internal identifier cannot be changed.</p>
                </div>

                <div class="mb-4">
                    <label for="displayName" class="block text-gray-700 text-sm font-bold mb-2">Display Name</label>
                    <input type="text" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500" 
                           id="displayName" name="displayName"
                           value="<%= role.displayName || role.name %>" required>
                </div>

                <div class="mb-6">
                    <label for="description" class="block text-gray-700 text-sm font-bold mb-2">Description</label>
                    <textarea class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500" 
                              id="description" name="description" rows="3"><%= role.description || '' %></textarea>
                </div>

                <div class="mb-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-key mr-2 text-gray-500"></i> Permissions
                    </h3>

                    <div class="space-y-6">
                        <% Object.entries(groupedPermissions).forEach(([category, perms]) => { %>
                            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                                <h4 class="font-bold text-gray-700 mb-3 uppercase text-xs tracking-wider border-b border-gray-200 pb-2">
                                    <%= category %>
                                </h4>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <% perms.forEach(perm => { %>
                                        <div class="flex items-start">
                                            <div class="flex items-center h-5">
                                                <input id="perm_<%= perm.id %>" name="permissionIds" value="<%= perm.id %>" type="checkbox" 
                                                       class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded"
                                                       <%= assignedPermissionIds.includes(perm.id) ? 'checked' : '' %>>
                                            </div>
                                            <div class="ml-3 text-sm">
                                                <label for="perm_<%= perm.id %>" class="font-medium text-gray-700 select-none">
                                                    <%= perm.name %>
                                                </label>
                                                <p class="text-gray-500 text-xs"><%= perm.description %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-4 border-t border-gray-100 pt-4">
                    <a href="/admin/roles" class="text-gray-600 hover:text-gray-800 font-bold">
                        Cancel
                    </a>
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded shadow transition duration-200">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>