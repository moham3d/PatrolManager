<%- layout('layouts/dashboard') -%>

<%- contentFor('body') { %>
<div class="roles-page">
    <!-- Page Header -->
    <div class="roles-page__header">
        <div>
            <h1 class="roles-page__title">Roles Management</h1>
            <p class="roles-page__subtitle">Manage user roles and permissions</p>
        </div>
        <a href="/admin/roles/create" class="btn btn-primary">
            <i data-lucide="plus"></i>
            <span>Create Role</span>
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="roles-page__stats grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <%- include('../partials/cards/stat-card', { stat: {
            title: 'Total Roles',
            value: roles.length,
            icon: 'shield',
            color: 'primary'
        }}) %>

        <%- include('../partials/cards/stat-card', { stat: {
            title: 'System Roles',
            value: roles.filter(r => ['admin', 'supervisor', 'guard'].includes(r.name)).length,
            icon: 'lock',
            color: 'warning'
        }}) %>

        <%- include('../partials/cards/stat-card', { stat: {
            title: 'Custom Roles',
            value: roles.filter(r => !['admin', 'supervisor', 'guard'].includes(r.name)).length,
            icon: 'user-plus',
            color: 'success'
        }}) %>
    </div>

    <!-- Roles Table -->
    <div class="roles-page__table">
        <%- include('../partials/tables/data-table', { table: {
            columns: [
                { key: 'name', label: 'Role Name', sortable: true },
                { key: 'description', label: 'Description' },
                { key: 'permissions', label: 'Permissions', render: (val) => `<span class="badge badge-info">${val.Permissions.length} permissions</span>` },
                { key: 'users', label: 'Users', render: (val) => `<span class="badge badge-${val.userCount > 0 ? 'success' : 'light'}">${val.userCount} users</span>` },
                { key: 'actions', label: 'Actions', sortable: false, render: (val, row) => {
                    const isSystemRole = ['admin', 'supervisor', 'guard'].includes(row.name);
                    return `
                        <div class="data-table__actions">
                            <a href="/admin/roles/${row.id}/edit" class="btn-icon btn-icon--primary" title="Edit">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </a>
                            ${!isSystemRole ? `
                                <button class="btn-icon btn-icon--danger" onclick="deleteRole(${row.id}, '${row.name}')" title="Delete">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            ` : ''}
                        </div>
                    `;
                }}
            ],
            rows: roles,
            emptyMessage: 'No roles found. Create your first role!'
        }}) %>
    </div>
</div>

<!-- Delete Role Modal -->
<div id="deleteModal" class="modal hidden">
    <div class="modal__backdrop" onclick="closeDeleteModal()"></div>
    <div class="modal__content">
        <div class="modal__header">
            <h2 class="modal__title">Delete Role</h2>
            <button class="modal__close" onclick="closeDeleteModal()">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="modal__body">
            <div class="modal__icon modal__icon--warning">
                <i data-lucide="alert-triangle"></i>
            </div>
            <p class="modal__message">
                Are you sure you want to delete role <strong id="deleteRoleName"></strong>?
            </p>
            <p class="modal__warning">
                This action cannot be undone.
            </p>
        </div>
        <div class="modal__footer">
            <button class="btn btn-secondary" onclick="closeDeleteModal()">
                Cancel
            </button>
            <button class="btn btn-danger" id="confirmDeleteBtn">
                <i data-lucide="trash-2"></i>
                <span>Delete Role</span>
            </button>
        </div>
    </div>
</div>

<script>
let roleToDelete = null;

function deleteRole(id, name) {
    roleToDelete = id;
    document.getElementById('deleteRoleName').textContent = name;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    roleToDelete = null;
    document.getElementById('deleteModal').classList.add('hidden');
}

document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (roleToDelete) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/roles/${roleToDelete}/delete`;

        // Add CSRF token
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'csrfToken';
        csrfInput.value = '<%= csrfToken %>';
        form.appendChild(csrfInput);

        document.body.appendChild(form);
        form.submit();
    }
});
</script>

<style>
.roles-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.roles-page__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
}

.roles-page__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
}

.roles-page__subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
}

.roles-page__stats {
    margin-bottom: 0;
}

.roles-page__table {
    background-color: var(--bg-tertiary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

/* Table Actions */
.data-table__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
}

.btn-icon:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-color-light);
    color: var(--text-primary);
}

.btn-icon--primary:hover {
    border-color: var(--color-primary-500);
    color: var(--color-primary-500);
}

.btn-icon--danger:hover {
    border-color: var(--color-danger-500);
    color: var(--color-danger-500);
}

/* Badges */
.badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    border-radius: var(--radius-full);
}

.badge-info {
    background-color: rgba(14, 165, 233, 0.1);
    color: var(--color-primary-500);
}

.badge-success {
    background-color: rgba(16, 185, 129, 0.1);
    color: var(--color-success-500);
}

.badge-light {
    background-color: rgba(148, 163, 184, 0.1);
    color: var(--text-secondary);
}

/* Modal */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: var(--z-modal);
}

.modal__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
}

.modal__content {
    position: relative;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2xl);
    max-width: 480px;
    width: 100%;
    margin: 1rem;
    animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
}

.modal__title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0;
}

.modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
}

.modal__close:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
}

.modal__body {
    padding: 2rem;
    text-align: center;
}

.modal__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
}

.modal__icon--warning {
    background-color: rgba(249, 115, 22, 0.1);
    color: var(--color-warning-500);
}

.modal__icon i {
    width: 32px;
    height: 32px;
}

.modal__message {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
}

.modal__warning {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
}

.modal__footer {
    display: flex;
    gap: 0.75rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border-color);
    justify-content: flex-end;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    font-family: var(--font-primary);
    text-decoration: none;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
}

.btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-color-light);
}

.btn-danger {
    background-color: var(--color-danger-600);
    color: #FFFFFF;
}

.btn-danger:hover {
    background-color: var(--color-danger-700);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
}

/* Responsive */
@media (max-width: 768px) {
    .roles-page__header {
        flex-direction: column;
        align-items: stretch;
    }

    .roles-page__title {
        font-size: var(--text-2xl);
    }
}
</style>
<% } %>
