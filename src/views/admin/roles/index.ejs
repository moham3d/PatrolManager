
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Role Management</h1>
            <p class="text-gray-600">Configure system roles and granular permissions</p>
        </div>
        <button onclick="document.getElementById('createRoleModal').classList.remove('hidden')"
            class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow transition duration-200 flex items-center">
            <i data-lucide="plus-circle" class="w-5 h-5 mr-2"></i> Create New Role
        </button>
    </div>

    <div class="bg-white rounded-lg shadow overflow-x-auto">
        <table class="min-w-full leading-normal">
            <thead>
                <tr>
                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        Role Name
                    </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        Description
                    </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider text-center">
                        Permissions
                    </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider text-center">
                        Users
                    </th>
                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                <% roles.forEach(role => { %>
                    <tr class="hover:bg-gray-50 transition duration-150">
                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                            <span class="px-3 py-1 font-bold text-blue-800 bg-blue-100 rounded-full text-xs uppercase tracking-wider">
                                <%= role.displayName || role.name %>
                            </span>
                            <div class="text-[10px] text-gray-400 mt-1">Code: <%= role.name %></div>
                        </td>
                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-gray-600">
                            <%= role.description || 'No description' %>
                        </td>
                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-center">
                            <span class="font-bold text-gray-700 bg-gray-100 px-2 py-1 rounded">
                                <%= role.permissions ? role.permissions.length : 0 %>
                            </span>
                        </td>
                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-center">
                            <span class="font-bold <%= role.userCount > 0 ? 'text-green-600 bg-green-50' : 'text-gray-400 bg-gray-50' %> px-2 py-1 rounded">
                                <%= role.userCount %>
                            </span>
                        </td>
                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-right">
                            <div class="flex justify-end space-x-3">
                                <button onclick="openEditRoleModal('<%= role.id %>')" class="text-blue-600 hover:text-blue-900" title="Edit Role">
                                    <i data-lucide="edit" class="w-5 h-5"></i>
                                </button>
                                <% if (!['admin', 'supervisor', 'guard'].includes(role.name.toLowerCase())) { %>
                                    <form action="/admin/roles/<%= role.id %>/delete" method="POST" class="inline-block"
                                          onsubmit="return confirm('Are you sure you want to delete this role?');">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="text-red-600 hover:text-red-900" title="Delete Role">
                                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <i data-lucide="lock" class="w-5 h-5 text-gray-300" title="System Protected"></i>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Create Role Modal -->
    <div id="createRoleModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md animate__animated animate__fadeInUp">
            <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800 flex items-center">
                    <i data-lucide="plus-circle" class="w-5 h-5 mr-2 text-blue-600"></i> Create New Role
                </h3>
                <button onclick="document.getElementById('createRoleModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form action="/admin/roles/create" method="POST" class="p-6 space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Role Code (e.g. manager)</label>
                    <input type="text" name="name" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Display Name</label>
                    <input type="text" name="displayName" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Description</label>
                    <textarea name="description" rows="3" class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                </div>
                <div class="flex justify-end pt-4 gap-3">
                    <button type="button" onclick="document.getElementById('createRoleModal').classList.add('hidden')"
                        class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md transition">
                        Create Role
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit Role Modal -->
    <div id="editRoleModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md animate__animated animate__fadeInUp">
            <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                <h3 class="font-bold text-lg text-slate-800 flex items-center">
                    <i data-lucide="edit" class="w-5 h-5 mr-2 text-blue-600"></i> Edit Role: <span id="editRoleTitleName"></span>
                </h3>
                <button onclick="document.getElementById('editRoleModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form id="editRoleForm" method="POST" class="p-6 space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Display Name</label>
                    <input type="text" id="edit-role-display-name" name="displayName" class="w-full border rounded-lg px-4 py-2 outline-none" required>
                </div>
                <div>
                    <label class="block text-slate-700 text-sm font-bold mb-2">Description</label>
                    <textarea id="edit-role-description" name="description" rows="3" class="w-full border rounded-lg px-4 py-2 outline-none"></textarea>
                </div>
                <div class="flex justify-end pt-4 gap-3">
                    <button type="button" onclick="document.getElementById('editRoleModal').classList.add('hidden')"
                        class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-md">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();
            
            window.openEditRoleModal = function(id) {
                fetch(`/admin/roles/${id}/edit`, { headers: { 'Accept': 'application/json' } })
                    .then(res => res.json())
                    .then(data => {
                        const role = data.role || data;
                        document.getElementById('editRoleForm').action = `/admin/roles/${role.id}/edit`;
                        document.getElementById('editRoleTitleName').innerText = role.displayName || role.name;
                        document.getElementById('edit-role-display-name').value = role.displayName || role.name;
                        document.getElementById('edit-role-description').value = role.description || '';
                        
                        document.getElementById('editRoleModal').classList.remove('hidden');
                    });
            };
        });
    </script>

    <% if (roles.length === 0) { %>
        <div class="text-center py-12 bg-white rounded-lg shadow mt-6">
            <i data-lucide="shield-off" class="w-16 h-16 mx-auto text-slate-200 mb-4"></i>
            <p class="text-slate-500 font-medium">No custom roles found. Create one to get started!</p>
        </div>
    <% } %>
</div>
